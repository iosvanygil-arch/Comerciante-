YAML
      - name: Diagnosticar estructura del proyecto
        run: |
          echo "CONTENIDO DEL ZIP:"
          find source -maxdepth 4 -type f | head -200
          echo "BUSCANDO PACKAGE.JSON:"
          find source -name package.json
          echo "BUSCANDO CONFIGURACION CAPACITOR:"
          find source -name capacitor.config.ts -o -name capacitor.config.json
          echo "BUSCANDO GRADLE:"
          find source -name gradlew
