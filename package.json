{
  "name": "comerciante-local",
  "version": "0.3.5",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test",
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "desktop": "electron .",
    "build:windows": "npm run build && electron-builder --win nsis portable"
  },
  "dependencies": {
    "jsbarcode": "^3.11.6",
    "qrcode": "^1.5.4",
    "@capacitor/core": "^7.4.3",
    "@capacitor/android": "^7.4.3"
  },
  "devDependencies": {
    "vite": "^6.0.0",
    "@capacitor/cli": "^7.4.3",
    "typescript": "^5.7.3",
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8"
  },
  "main": "electron.cjs",
  "build": {
    "appId": "com.comerciante.local",
    "productName": "COMERCIANTE",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron.cjs"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "COMERCIANTE-${version}-${target}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
